def fft_normalize(data, norm='ortho'):
    """
    Normalization of frequency spectrum

    Args:
        data: torch.Tensor
        norm: 'ortho' or 'backward'

    Returns:
        magnitude_norm: torch.Tensor
    """
    fft_result = torch.fft.rfft(data, dim=1, norm=norm)

    magnitude = torch.abs(fft_result)

    min_vals = magnitude.min(dim=1, keepdim=True)[0] 
    max_vals = magnitude.max(dim=1, keepdim=True)[0] 

    range_vals = max_vals - min_vals
    range_vals = torch.where(range_vals == 0, torch.ones_like(range_vals), range_vals)

    magnitude_norm = (magnitude - min_vals) / range_vals 

    return magnitude_norm


def evaluate_model(model_cls, test_loader, device):
    """
    Evaluate the model on test dataset
    """
    model_cls.eval()
    correct = 0
    total = 0
    all_preds = []
    all_labels = []

    with torch.no_grad():
        for data, labels in test_loader:
            data = data.to(device)
            labels = labels.to(device)

            outputs, feature = model_cls(data)
            _, predicted = torch.max(outputs, 1)
            correct += (predicted == labels.squeeze(1)).sum().item()
            total += labels.size(0)

            outputs = outputs.cpu().detach()
            all_preds.extend(predicted.cpu().numpy())
            all_labels.extend(labels.cpu().numpy())

    accuracy = 100 * correct / total
    return accuracy, all_preds, all_labels, outputs, feature



