import torch
import torch.nn as nn
import numpy as np
import torch.optim as optim
import argparse
parser = argparse.ArgumentParser()
args = parser.parse_args(args=[])
args.device = 'cuda'
if torch.cuda.is_available():
    args.device = 'cuda:0'


class Classifier(nn.Module):
    def __init__(self, args):
        super().__init__()

        self.conv1 = nn.Conv1d(1, 8, kernel_size=128)
        self.relu1 = nn.ReLU()
        self.pool1 = nn.MaxPool1d(4)

        self.conv2 = nn.Conv1d(8, 16, kernel_size=64)
        self.relu2 = nn.ReLU()
        self.pool2 = nn.MaxPool1d(4)

        self.conv3 = nn.Conv1d(16, 32, kernel_size=16)
        self.relu3 = nn.ReLU()
        self.pool3 = nn.MaxPool1d(4)

        self.flatten = nn.Flatten()

        self.fc1 = nn.Linear(192, 64)
        self.relu_fc1 = nn.ReLU()
        self.dropout = nn.Dropout(0.5)

        self.fc2 = nn.Linear(64, 3)
        self.softmax = nn.Softmax(dim=1)

    def forward(self, x):
        x = x.unsqueeze(1)

        x = self.pool1(self.relu1(self.conv1(x)))
        x = self.pool2(self.relu2(self.conv2(x)))
        x = self.pool3(self.relu3(self.conv3(x)))

        feature = self.flatten(x)
        output = self.dropout(self.relu_fc1(self.fc1(feature)))
        output = self.softmax(self.fc2(output))

        return output, feature
